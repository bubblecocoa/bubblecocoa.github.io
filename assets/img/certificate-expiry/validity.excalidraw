      "link": null,
      "locked": false,
      "text": "짧은 유효기간 → 기존 인증서의 유효 기간을 제한",
      "fontSize": 23,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "짧은 유효기간 → 기존 인증서의 유효 기간을 제한",
      "autoResize": true,
      "lineHeight": 1.25
    },

      "link": null,
      "locked": false,
      "text": "스킬은 필요할 때 불러오고, 기억은 새 세션에서 읽습니다.",
      "fontSize": 22,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "스킬은 필요할 때 불러오고, 기억은 새 세션에서 읽습니다.",
      "autoResize": true,
      "lineHeight": 1.15
    },
